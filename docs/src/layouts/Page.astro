---
import AiModeRoot from '../features/ai-mode/components/AiModeRoot.tsx';
import '../styles/global.css';

const DEFAULT_DESCRIPTION =
  'The .cv open file format. One file packs a designed PDF, a clean Markdown copy, an HTML rendering, and ' +
  'pre-computed BGE-M3 embeddings so every audience (humans, ATS, AI agents) reads the same source of truth.';
const FONT_FAMILIES = [
  'Archivo:wght@500;600;700;800',
  'Hanken+Grotesk:wght@400;500;600;700',
  'Spline+Sans+Mono:wght@400;500;600',
];
const FONTS_URL = `https://fonts.googleapis.com/css2?${FONT_FAMILIES.map((f) => `family=${f}`).join('&')}&display=swap`;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  // The assistant of the header's "Ask the spec" button: the docs assistant, or on /view/ the file assistant.
  assistant?: 'docs' | 'view';
}

const {
  title,
  description = DEFAULT_DESCRIPTION,
  ogImage = '/og.png',
  noindex = false,
  assistant = 'docs',
} = Astro.props;

const siteUrl = Astro.site?.origin ?? 'https://cvfile.org';
const pathname = Astro.url.pathname;
const canonical = new URL(pathname, siteUrl).toString();
const ogImageAbs = new URL(ogImage, siteUrl).toString();

const NAV = [
  { href: '/create/', label: 'Create', n: '01' },
  { href: '/view/', label: 'Demo', n: '02' },
  { href: '/spec/', label: 'Spec', n: '03' },
  { href: '/install/', label: 'Install', n: '04' },
  { href: '/ecosystem/', label: 'Ecosystem', n: '05' },
];
const isActive = (href: string) => pathname === href || pathname === href.replace(/\/$/, '');
const DESIGN_CREDIT_URL = 'https://laboetie.io?utm_source=cvfile&utm_medium=referral&utm_campaign=footer_credit';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex,nofollow" />}

    <meta name="theme-color" content="#f6f3ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1a1814" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="cvfile.org" />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="cvfile.org" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="cvfile.org changelog"
      href="https://github.com/cvfile/cv/releases.atom"
    />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={FONTS_URL} />

    <script is:inline>
      // Theme override on top of the OS preference. The palette is built on
      // CSS light-dark(), so forcing the root color-scheme is enough; "auto"
      // restores `light dark` and the OS decides. Runs pre-paint to avoid FOUC.
      (function () {
        var KEY = 'cv-theme';
        var ORDER = ['auto', 'light', 'dark'];
        var LABEL = { auto: '◐ Auto', light: '○ Light', dark: '● Dark' };
        function current() {
          try {
            var v = localStorage.getItem(KEY);
            return v === 'light' || v === 'dark' ? v : 'auto';
          } catch (e) { return 'auto'; }
        }
        function apply(mode) {
          document.documentElement.style.colorScheme = mode === 'auto' ? 'light dark' : mode;
        }
        apply(current());
        document.addEventListener('DOMContentLoaded', function () {
          var btn = document.getElementById('theme-toggle');
          if (!btn) {
            return;
          }
          function render() {
            btn.textContent = LABEL[current()];
            btn.setAttribute('aria-label', 'Theme: ' + current() + ', tap to change');
          }
          function remember(mode) {
            try {
              if (mode === 'auto') {
                localStorage.removeItem(KEY);
              } else {
                localStorage.setItem(KEY, mode);
              }
            } catch (e) {}
          }
          render();
          btn.addEventListener('click', function () {
            var next = ORDER[(ORDER.indexOf(current()) + 1) % ORDER.length];
            remember(next);
            apply(next);
            render();
          });
        });
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <header class="titleblock">
      <div class="titleblock__inner">
        <a href="/" class="brand">
          <span class="brand__mark"><span class="dot">.</span>cv</span>
          <span class="brand__tag label">Open Resume File Format</span>
        </a>
        <nav class="nav" aria-label="Primary">
          {NAV.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
              <span class="num">{item.n}</span>{item.label}
            </a>
          ))}
          <a class="gh" href="https://github.com/cvfile/cv" rel="noopener">GitHub ↗</a>
          <AiModeRoot client:only="react" assistant={assistant}>
            <button slot="fallback" type="button" class="theme-toggle ai-launch" disabled>Ask the spec</button>
          </AiModeRoot>
          <button id="theme-toggle" type="button" class="theme-toggle" aria-label="Theme: auto, tap to change">
            ◐ Auto
          </button>
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="titleblock-foot">
      <dl class="foot-grid">
        <div class="foot-field">
          <dt>Specification</dt>
          <dd><a href="/spec/">cv 1.0 · stable</a></dd>
        </div>
        <div class="foot-field">
          <dt>Media Type</dt>
          <dd>application/vnd.cv+pdf</dd>
        </div>
        <div class="foot-field">
          <dt>Code License</dt>
          <dd>Apache 2.0</dd>
        </div>
        <div class="foot-field">
          <dt>Spec License</dt>
          <dd>CC BY 4.0</dd>
        </div>
        <div class="foot-field">
          <dt>Source</dt>
          <dd><a href="https://github.com/cvfile/cv" rel="noopener">github.com/cvfile/cv</a></dd>
        </div>
      </dl>
      <div class="foot-note">
        <span>
          Drawn by the cvfile.org community<span class="foot-sep" aria-hidden="true">·</span><a
            class="foot-credit"
            href={DESIGN_CREDIT_URL}
            target="_blank"
            rel="noopener">Designed by La Boétie</a>
        </span>
        <span>The format and its reference tools are free to use.</span>
      </div>
    </footer>
  </body>
</html>
