---
interface Props {
  title: string;
  description?: string;
}
const { title, description = 'The .cv open file format — one file, three audiences, real semantic search.' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://cvfile.org" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: light dark;
        --bg: #fafaf9;
        --fg: #111;
        --muted: #6b7280;
        --border: #e5e5e3;
        --accent: #4f46e5;
        --code-bg: #1e1e2e;
        --max-width: 880px;
      }
      @media (prefers-color-scheme: dark) {
        :root {
          --bg: #0b0b0d;
          --fg: #f3f4f6;
          --muted: #9ca3af;
          --border: #2a2a2e;
          --accent: #818cf8;
        }
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif;
        background: var(--bg);
        color: var(--fg);
        line-height: 1.65;
      }
      header.site, footer.site {
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 1.25rem 1.5rem;
      }
      header.site { display: flex; align-items: baseline; gap: 1.5rem; border-bottom: 1px solid var(--border); }
      header.site h1 { font-size: 1.1rem; margin: 0; }
      header.site nav { margin-left: auto; display: flex; gap: 1.25rem; font-size: 0.95rem; }
      header.site a { color: inherit; text-decoration: none; }
      header.site a:hover { color: var(--accent); }
      main { max-width: var(--max-width); margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      h2 { margin-top: 2.5rem; }
      pre {
        background: var(--code-bg);
        color: #e2e8f0;
        padding: 1rem 1.25rem;
        border-radius: 8px;
        overflow-x: auto;
        font-size: 0.9rem;
        line-height: 1.55;
      }
      code:not(pre code) {
        background: rgba(127, 127, 127, 0.12);
        padding: 0.1rem 0.35rem;
        border-radius: 4px;
        font-size: 0.92em;
      }
      a { color: var(--accent); }
      footer.site {
        border-top: 1px solid var(--border);
        font-size: 0.85rem;
        color: var(--muted);
      }
    </style>
  </head>
  <body>
    <header class="site">
      <h1><a href="/">cvfile.org</a></h1>
      <nav>
        <a href="/spec/">Spec</a>
        <a href="/install/">Install</a>
        <a href="/view/">Demo</a>
        <a href="https://github.com/cvfile/cv">GitHub</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site">
      <div>Apache-2.0 / spec CC-BY-4.0 — built by the cvfile.org community.</div>
    </footer>
  </body>
</html>
