---
import Page from '../layouts/Page.astro';
import {
  ORGANIZATION,
  WEBSITE,
  SOFTWARE_APPLICATION,
  breadcrumbs,
  faqPage,
  graph,
} from '../lib/structured-data';

const FAQS = [
  {
    question: 'What is the .cv file format?',
    answer:
      '.cv is an open file format for resumes. It is a valid PDF/A-3u file that bundles a designed PDF, a clean Markdown copy, a self-contained HTML rendering, and optional pre-computed BGE-M3 embeddings inside one file. Any PDF reader opens it visually; ATS systems and AI agents read the embedded Markdown directly.',
  },
  {
    question: 'How is .cv different from JSON Resume, FRESH, or Europass?',
    answer:
      'Those are pure data schemas (JSON or XML) that drop the visual artifact and require the consumer to render. .cv keeps the designer-controlled PDF intact and travels the JSON/Markdown/HTML alongside it as PDF Associated Files (ISO 32000-2 §14.13). A recruiter still opens a polished PDF; an ATS or LLM still reads clean text; both come from the same file.',
  },
  {
    question: 'Do I need a special viewer to open a .cv file?',
    answer:
      'No. A .cv is a valid PDF. Preview, Adobe Reader, Chrome, every PDF reader shipped in the last fifteen years opens it normally and shows the visual layer. The additional payloads (Markdown, HTML, embeddings) are discoverable via standard PDF Associated Files mechanism.',
  },
  {
    question: 'Why are pre-computed embeddings inside the file?',
    answer:
      'So that any third-party RAG pipeline indexing the file (LangChain, LlamaIndex, Haystack, custom vector DB) can skip the embedding API call entirely. Default model is BAAI BGE-M3 (MIT licensed, multilingual, 1024-dim, free). Producers may also ship vectors in proprietary spaces (OpenAI text-embedding-3-large, Voyage-3, Gemini-text-004) when they target a specific downstream stack.',
  },
  {
    question: 'What MIME type does a .cv file use?',
    answer:
      'application/vnd.cv+pdf, registered (pending) with IANA per RFC 6838 vendor tree and RFC 8081 structured suffix +pdf. Until IANA approves, servers safely emit application/pdf alongside a Link header advertising the .cv alternates. A 200-line reference sniffer (cvfile-cv-detector, available in Python, Go, and TypeScript) detects .cv wrapping inside any application/pdf bytes.',
  },
  {
    question: 'Is the format and tooling free?',
    answer:
      'Yes. The spec is CC-BY-4.0. The CLI, the three SDKs (JavaScript, Python, Go), the web component, the server middleware, and the RAG integrations (langchain-cvfile, llama-index-readers-cvfile, cvfile-haystack) are Apache-2.0. There is no vendor lock-in. A planned cvfile.org/cloud paid tier exists for hosted convenience but is non-essential.',
  },
  {
    question: 'Can a job seeker create a .cv file?',
    answer:
      'Two paths. (1) Use the in-browser builder at cvfile.org/create, fill a form, and download a .cv with PDF + Markdown payloads ready. (2) Install the CLI (brew install cvfile/tap/cv) and run cv pack with your existing PDF + Markdown.',
  },
  {
    question: 'How can an ATS or LLM read the inside of a .cv file?',
    answer:
      'Several options. (a) Use one of the published reference SDKs (npm: @cvfile/sdk, PyPI: cvfile, Go: github.com/cvfile/cv/sdks/go). (b) Use one of the RAG integrations (langchain-cvfile, llama-index-readers-cvfile, cvfile-haystack). (c) Use the 200-line cvfile-cv-detector reference sniffer that depends only on the PDF parser the host already trusts. (d) Send an Accept: text/markdown header to a server running the @cvfile/server middleware; you receive the Markdown payload directly.',
  },
];

const jsonLd = graph([
  ORGANIZATION,
  WEBSITE,
  SOFTWARE_APPLICATION,
  breadcrumbs([{ name: 'cvfile.org', url: 'https://cvfile.org/' }]),
  faqPage(FAQS),
]);

const PAYLOADS = [
  { glyph: '▦', name: 'resume.pdf', type: 'application/pdf', role: 'the visual layer', primary: false },
  { glyph: '▤', name: 'resume.md', type: 'text/markdown', role: 'ATS · AI', primary: true },
  { glyph: '◫', name: 'resume.html', type: 'text/html', role: 'the web', primary: false },
  { glyph: '◈', name: 'embeddings.cbor', type: 'vnd.cv.embeddings+cbor', role: 'BGE-M3 · 1024d', primary: false },
];

const PATHS = [
  {
    n: '01',
    tag: 'Developers / AI',
    title: 'I build RAG and AI tooling.',
    body: 'Read the embedded Markdown and precomputed vectors directly. LangChain, LlamaIndex and Haystack loaders, or a 200-line sniffer. No OCR pass, no re-embedding.',
    href: '/ecosystem/',
    cta: 'Browse the ecosystem',
  },
  {
    n: '02',
    tag: 'Job seekers',
    title: 'I am writing my resume.',
    body: 'Fill a form, download one .cv file, upload it to Workday, Greenhouse, Lever, LinkedIn or your own site. One file, every audience, never out of sync.',
    href: '/create/',
    cta: 'Create your .cv',
  },
  {
    n: '03',
    tag: 'ATS / CRM / Recruiters',
    title: 'I run a hiring platform.',
    body: 'Drop in the server middleware for Express, Fastify, Hono, FastAPI, Django or Go. Content negotiation hands your crawler clean text. The wrapper stays invisible.',
    href: '/install/',
    cta: 'Read the integration',
  },
];
---
<Page
  title="cvfile.org · the .cv open file format"
  description="One file packs a designed PDF, a clean Markdown copy, an HTML rendering, and pre-computed BGE-M3 embeddings inside a single PDF/A-3u. Apache-2.0 spec and SDKs in JavaScript, Python, and Go."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <!-- ============ HERO ============ -->
  <section class="hero sheet">
    <div class="hero__copy">
      <p class="hero__status" data-rise style="--d: 0ms">
        <span>Spec cv 1.0</span><i></i><span>Apache 2.0</span><i></i><span>IANA media type</span>
      </p>
      <h1 data-rise style="--d: 60ms">One file.<br />Three readers.<br />One source of truth.</h1>
      <p class="lede" data-rise style="--d: 140ms">
        <code>.cv</code> is the open file format for resumes. A single PDF/A-3u
        that carries a designed PDF, a clean Markdown copy, an HTML rendering,
        and pre-computed BGE-M3 vectors. It opens in any PDF reader on day one;
        machines read the text inside without OCR.
      </p>
      <div class="cta-row" data-rise style="--d: 220ms">
        <a href="/create/" class="btn btn--primary">Create your .cv <span class="arrow">→</span></a>
        <a href="/spec/" class="btn btn--ghost">Read the spec</a>
        <a href="/install/" class="hero__textlink">or install the CLI</a>
      </div>
      <dl class="legend" data-rise style="--d: 300ms">
        <div><dt>Humans</dt><dd>the designed PDF</dd></div>
        <div><dt>ATS · CRM · recruiters</dt><dd>clean Markdown</dd></div>
        <div><dt>AI · RAG pipelines</dt><dd>precomputed vectors</dd></div>
      </dl>
    </div>

    <!-- The schematic: a .cv file, exploded -->
    <figure class="schematic" aria-label="A .cv file is a PDF/A-3u container holding four payloads">
      <div class="schem__rule schem__rule--top"><span class="label">application/vnd.cv+pdf</span><span class="label">PDF/A-3u</span></div>
      <div class="schem__frame">
        <span class="tick tick--tl"></span><span class="tick tick--tr"></span>
        <span class="tick tick--bl"></span><span class="tick tick--br"></span>
        <ul class="payloads">
          {PAYLOADS.map((p, i) => (
            <li class:list={['payload', { 'is-primary': p.primary }]} data-rise style={`--d: ${360 + i * 90}ms`}>
              <span class="payload__glyph" aria-hidden="true">{p.glyph}</span>
              <span class="payload__name">{p.name}</span>
              <span class="payload__type">{p.type}</span>
              <span class="payload__role">{p.role}{p.primary && <em> ← primary</em>}</span>
            </li>
          ))}
        </ul>
      </div>
      <div class="schem__rule schem__rule--bottom">
        <span class="label">XMP · cv: namespace</span><span class="label">SHA-256 per payload</span>
      </div>
      <figcaption class="label" data-rise style="--d: 740ms">Fig.1 · one container, every copy verified in sync</figcaption>
    </figure>
  </section>

  <!-- ============ THREE PATHS ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§01</span><span class="label">Paths</span></div>
      <div class="block__body">
        <h2>Pick the path that matches your role.</h2>
        <p>The same file serves three audiences. Start where you stand.</p>
        <div class="paths">
          {PATHS.map((path) => (
            <a class="path" href={path.href}>
              <div class="path__head">
                <span class="path__n">{path.n}</span>
                <span class="label">{path.tag}</span>
              </div>
              <h3>{path.title}</h3>
              <p>{path.body}</p>
              <span class="path__cta">{path.cta} <span class="arrow">→</span></span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ WHY ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§02</span><span class="label">Rationale</span></div>
      <div class="block__body">
        <h2>Four artifacts drift. One file does not.</h2>
        <p>
          Today a person sends three different artifacts to three different
          audiences: a polished PDF to recruiters, a Markdown copy to ATS
          systems, a web bio for their site. They fall out of sync within weeks.
          AI tools re-OCR and re-embed the same documents over and over.
        </p>
        <p>
          <code>.cv</code> collapses them into one. One file, one source of
          truth, opens in any PDF reader on day one. Bots that ask for
          <code>text/markdown</code> get the Markdown back. RAG pipelines that
          recognise the format read precomputed BGE-M3 vectors directly instead
          of re-embedding.
        </p>
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§03</span><span class="label">Comparison</span></div>
      <div class="block__body">
        <h2>Schemas drop the design. PDFs drop the text. <code>.cv</code> keeps both.</h2>
        <div class="table-scroll">
          <table class="spec-table">
            <thead>
              <tr>
                <th>Format</th>
                <th>Visual PDF</th>
                <th>Clean ATS text</th>
                <th>Precomputed vectors</th>
                <th>Opens anywhere</th>
              </tr>
            </thead>
            <tbody>
              <tr class="is-primary">
                <td><code>.cv</code></td>
                <td class="yes">yes</td><td class="yes">yes</td><td class="yes">yes</td><td class="yes">yes</td>
              </tr>
              <tr>
                <td>JSON Resume / FRESH</td>
                <td class="no">data only</td><td class="yes">yes</td><td class="no">no</td><td class="no">no</td>
              </tr>
              <tr>
                <td>Europass XML</td>
                <td class="no">data only</td><td class="yes">yes</td><td class="no">no</td><td class="no">no</td>
              </tr>
              <tr>
                <td>HR-XML / HR Open</td>
                <td class="no">data only</td><td class="yes">yes</td><td class="no">no</td><td class="no">no</td>
              </tr>
              <tr>
                <td>Plain PDF</td>
                <td class="yes">yes</td><td class="no">OCR only</td><td class="no">no</td><td class="yes">yes</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ KILLER PROPERTY ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§04</span><span class="label">Invisible</span></div>
      <div class="block__body">
        <h2>The consumer never learns <code>.cv</code> exists.</h2>
        <p>
          A producer ships <strong>one</strong> file. The HTTP middleware reads
          the <code>Accept</code> header and hands every consumer exactly the
          representation it wants. The wrapper is producer-side convenience;
          consumer-side it stays invisible.
        </p>
        <div class="negotiation">
          {[
            { accept: 'text/html, */*', who: 'LLM crawlers, browsers', sees: 'extracted resume.html' },
            { accept: 'text/markdown', who: 'newer agents, our SDK', sees: 'extracted resume.md' },
            { accept: 'application/pdf', who: 'PDF clients', sees: 'the visual PDF' },
            { accept: 'no Accept header', who: 'anything else', sees: 'the visual PDF' },
          ].map((row) => (
            <div class="neg-row">
              <code class="neg-accept">{row.accept}</code>
              <span class="neg-who label">{row.who}</span>
              <span class="neg-arrow" aria-hidden="true">→</span>
              <span class="neg-sees">{row.sees}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HELLO .CV ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§05</span><span class="label">Hello, .cv</span></div>
      <div class="block__body">
        <h2>Pack once. Read it any way you like.</h2>
        <p class="plate-caption">terminal · cv command line</p>
        <pre><code>{`# Build a .cv from a markdown CV
cv pack \\
  --pdf resume.pdf \\
  --md resume.md \\
  --html resume.html \\
  --lang en \\
  -o resume.cv

# Read it back any way you like
cv extract resume.cv --format md      # markdown stream
cv inspect resume.cv --json           # XMP + payload metadata
cv validate resume.cv --strict        # PDF/A-3u + cv-strict gate
cv search  resume.cv "kubernetes"     # semantic search via BGE-M3`}</code></pre>
      </div>
    </div>
  </section>

  <!-- ============ SHIPS TODAY ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§06</span><span class="label">Status</span></div>
      <div class="block__body">
        <h2>What ships today.</h2>
        <ol class="feat-list">
          <li><span>Stable spec at <a href="/spec/">cv-1.0</a>, frozen and versioned.</span></li>
          <li><span>Reference SDKs in <strong>JavaScript</strong>, <strong>Python</strong>, and <strong>Go</strong>.</span></li>
          <li><span>Single-binary CLI: <code>cv extract / inspect / validate / search</code>.</span></li>
          <li><span><code>&lt;cv-embed&gt;</code> web component (Lit, ~10 KB shell, lazy PDF.js worker).</span></li>
          <li><span>Server middleware for Express, Fastify, Hono, FastAPI, Flask, Django, Go <code>net/http</code>.</span></li>
          <li><span>Optional BGE-M3 embedding generation (<code>@cvfile/embed</code>, <code>cvfile[embed]</code>).</span></li>
          <li><span>LangChain, LlamaIndex, and Haystack document loaders.</span></li>
          <li><span>200-line reference sniffer (<code>cvfile-cv-detector</code>) for crawler vendors.</span></li>
        </ol>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="sheet">
    <div class="block">
      <div class="block__marg"><span class="sec">§07</span><span class="label">FAQ</span></div>
      <div class="block__body">
        <h2>Frequently asked questions.</h2>
        <div class="faq">
          {FAQS.map((item, i) => (
            <details class="faq__item">
              <summary>
                <span class="faq__n">{String(i + 1).padStart(2, '0')}</span>
                <span class="faq__q">{item.question}</span>
                <span class="faq__mark" aria-hidden="true"></span>
              </summary>
              <p>{item.answer}</p>
            </details>
          ))}
        </div>
      </div>
    </div>
  </section>

  <style>
    /* ---------- Hero ---------- */
    .hero {
      display: grid;
      grid-template-columns: 1.04fr 0.96fr;
      gap: var(--space-3xl);
      align-items: center;
      padding: clamp(var(--space-2xl), 6vw, var(--space-4xl)) var(--space-lg);
    }
    .hero__status {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: var(--space-2xs) var(--space-sm);
      font-family: var(--mono);
      font-size: 0.72rem;
      letter-spacing: 0.14em;
      text-transform: uppercase;
      color: var(--ink-soft);
      margin: 0 0 var(--space-lg);
    }
    .hero__status i { width: 4px; height: 4px; background: var(--accent); border-radius: 50%; }
    .hero h1 { margin-bottom: var(--space-lg); }
    .hero .lede { margin-bottom: var(--space-xl); }
    .hero .lede code { white-space: nowrap; }
    .hero__textlink {
      font-family: var(--mono);
      font-size: 0.78rem;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: var(--ink-soft);
      text-decoration: none;
      align-self: center;
      padding-left: var(--space-2xs);
    }
    .hero__textlink:hover { color: var(--accent); }

    .legend { margin: var(--space-2xl) 0 0; display: grid; gap: var(--space-sm); max-width: none; }
    .legend > div { display: grid; grid-template-columns: 13rem 1fr; gap: var(--space-md); align-items: baseline; padding-top: var(--space-sm); border-top: 1px solid var(--line); }
    .legend dt { font-family: var(--mono); font-size: 0.74rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink); margin: 0; }
    .legend dd { margin: 0; color: var(--ink-soft); font-size: 0.95rem; }

    /* ---------- Schematic ---------- */
    .schematic { margin: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
    .schem__rule { display: flex; justify-content: space-between; align-items: center; padding: 0 var(--space-2xs); }
    .schem__rule--top { padding-bottom: var(--space-2xs); }
    .schem__frame {
      position: relative;
      border: 1px solid var(--line-strong);
      border-radius: var(--radius);
      background: color-mix(in oklab, var(--paper-2) 60%, transparent);
      padding: var(--space-md);
    }
    .tick { position: absolute; width: 9px; height: 9px; border: 1px solid var(--accent); }
    .tick--tl { top: -1px; left: -1px; border-right: 0; border-bottom: 0; }
    .tick--tr { top: -1px; right: -1px; border-left: 0; border-bottom: 0; }
    .tick--bl { bottom: -1px; left: -1px; border-right: 0; border-top: 0; }
    .tick--br { bottom: -1px; right: -1px; border-left: 0; border-top: 0; }

    .payloads { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: var(--space-xs); }
    .payload {
      display: grid;
      grid-template-columns: 1.5rem minmax(0, 1fr) auto;
      grid-template-rows: auto auto;
      align-items: center;
      gap: 0 var(--space-sm);
      padding: var(--space-sm) var(--space-md);
      background: var(--paper);
      border: 1px solid var(--line);
      border-radius: 2px;
    }
    .payload__glyph { grid-row: 1 / 3; font-size: 1.1rem; color: var(--ink-soft); text-align: center; }
    .payload__name { font-family: var(--mono); font-weight: 600; font-size: 0.9rem; color: var(--ink); }
    .payload__type { grid-column: 2; font-family: var(--mono); font-size: 0.68rem; color: var(--ink-faint); overflow-wrap: anywhere; }
    .payload__role { grid-column: 3; grid-row: 1 / 3; font-family: var(--mono); font-size: 0.7rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-soft); text-align: right; }
    @media (max-width: 520px) {
      .payload { grid-template-columns: 1.5rem 1fr; }
      .payload__role { grid-column: 2; grid-row: auto; text-align: left; margin-top: var(--space-2xs); }
    }
    .payload.is-primary { border-color: var(--accent); background: color-mix(in oklab, var(--accent) 7%, var(--paper)); }
    .payload.is-primary .payload__glyph,
    .payload.is-primary .payload__role { color: var(--accent); }
    .payload__role em { font-style: normal; color: var(--accent); font-weight: 600; }

    figcaption.label { margin-top: var(--space-xs); text-align: right; }

    /* ---------- Paths ---------- */
    .paths { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 0; margin-top: var(--space-xl); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
    .path {
      display: flex;
      flex-direction: column;
      gap: var(--space-xs);
      padding: var(--space-xl);
      text-decoration: none;
      color: var(--ink);
      border-right: 1px solid var(--line);
      transition: background 160ms;
    }
    .path:last-child { border-right: 0; }
    .path:hover { background: var(--paper-2); }
    .path__head { display: flex; align-items: baseline; gap: var(--space-sm); margin-bottom: var(--space-xs); }
    .path__n { font-family: var(--display); font-weight: 800; font-size: 1.6rem; color: var(--accent); line-height: 1; }
    .path h3 { margin: 0; }
    .path p { color: var(--ink-soft); font-size: 0.95rem; margin: 0; flex: 1; }
    .path__cta { font-family: var(--mono); font-size: 0.76rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--ink); margin-top: var(--space-sm); display: inline-flex; gap: var(--space-xs); }
    .path:hover .path__cta { color: var(--accent); }
    .path:hover .arrow { transform: translateX(3px); }
    .path .arrow { transition: transform 160ms cubic-bezier(0.2,0.8,0.2,1); }
    @media (max-width: 720px) {
      .paths { grid-template-columns: 1fr; }
      .path { border-right: 0; border-bottom: 1px solid var(--line); }
      .path:last-child { border-bottom: 0; }
    }

    /* ---------- Negotiation ---------- */
    .negotiation { margin-top: var(--space-lg); display: flex; flex-direction: column; }
    .neg-row {
      display: grid;
      grid-template-columns: minmax(11rem, auto) 1fr 1.2rem minmax(10rem, auto);
      align-items: center;
      gap: var(--space-md);
      padding: var(--space-md) 0;
      border-top: 1px solid var(--line);
    }
    .neg-row:last-child { border-bottom: 1px solid var(--line); }
    .neg-accept { white-space: nowrap; }
    .neg-who { text-align: left; }
    .neg-arrow { color: var(--accent); text-align: center; font-family: var(--mono); }
    .neg-sees { font-family: var(--mono); font-size: 0.84rem; color: var(--ink); }
    @media (max-width: 680px) {
      .neg-row { grid-template-columns: 1fr auto; gap: var(--space-xs); }
      .neg-who { grid-column: 1 / -1; order: 3; }
      .neg-arrow { display: none; }
    }

    .table-scroll { overflow-x: auto; }

    /* ---------- FAQ ---------- */
    .faq { margin-top: var(--space-md); border-top: 1px solid var(--line); }
    .faq__item { border-bottom: 1px solid var(--line); }
    .faq__item summary {
      display: grid;
      grid-template-columns: 2.2rem 1fr 1.5rem;
      align-items: baseline;
      gap: var(--space-sm);
      padding: var(--space-md) 0;
      cursor: pointer;
      list-style: none;
    }
    .faq__item summary::-webkit-details-marker { display: none; }
    .faq__n { font-family: var(--mono); font-size: 0.74rem; color: var(--ink-faint); }
    .faq__q { font-family: var(--display); font-weight: 600; font-size: 1.05rem; color: var(--ink); letter-spacing: -0.01em; }
    .faq__mark { position: relative; width: 13px; height: 13px; justify-self: end; align-self: center; }
    .faq__mark::before, .faq__mark::after { content: ''; position: absolute; background: var(--accent); transition: transform 180ms ease; }
    .faq__mark::before { top: 6px; left: 0; width: 13px; height: 1.5px; }
    .faq__mark::after { left: 6px; top: 0; width: 1.5px; height: 13px; }
