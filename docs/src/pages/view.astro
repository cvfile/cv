---
import Page from '../layouts/Page.astro';
import { graph, ORGANIZATION, WEBSITE, breadcrumbs } from '../lib/structured-data';

const jsonLd = graph([
  ORGANIZATION,
  WEBSITE,
  breadcrumbs([
    { name: 'cvfile.org', url: 'https://cvfile.org/' },
    { name: 'Demo', url: 'https://cvfile.org/view/' },
  ]),
]);
---
<Page
  title="Live .cv viewer · cvfile.org"
  description="Drop a .cv file or load the sample to see all three payloads (PDF, Markdown, HTML) and the XMP metadata side by side, rendered entirely in your browser."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <div class="doc doc--narrow">
    <header class="page-head">
      <span class="kicker label">§02 / Demo</span>
      <h1>See all three payloads, side by side.</h1>
      <p>
        Drop any <code>.cv</code> file below or load the sample. The
        <code>&lt;cv-embed&gt;</code> web component parses the bundle entirely in
        your browser and lets you flip between the PDF, Markdown and HTML copies.
      </p>
    </header>

    <div class="viewer-actions">
      <button id="load-sample" type="button" class="btn btn--primary">Load sample .cv <span class="arrow">→</span></button>
      <a href="/samples/jane-doe.cv" download="jane-doe.cv" class="btn btn--ghost">Download sample</a>
    </div>

    <label id="dropzone" class="dz">
      <strong>Drop a .cv file here</strong>
      <span class="dz__sub">or click to choose</span>
      <input id="picker" class="visually-hidden-file" type="file" accept=".cv,application/pdf,application/vnd.cv+pdf" />
    </label>

    <cv-embed id="viewer" view="auto" theme="auto" style="display: none;"></cv-embed>
  </div>

  <style>
    .viewer-actions { display: flex; gap: var(--space-sm); flex-wrap: wrap; margin-bottom: var(--space-lg); }
    .dz {
      position: relative;
      display: flex; flex-direction: column; align-items: center; gap: var(--space-2xs);
      border: 1.5px dashed var(--line-strong); border-radius: var(--radius);
      padding: var(--space-3xl) var(--space-lg); text-align: center; cursor: pointer;
      background: color-mix(in oklab, var(--paper-2) 50%, transparent);
      transition: background 140ms, border-color 140ms;
    }
    .dz:hover { border-color: var(--ink-faint); }
    .dz strong { color: var(--ink); font-family: var(--mono); font-size: 0.92rem; }
    .dz__sub { color: var(--ink-faint); font-family: var(--mono); font-size: 0.74rem; }
  </style>

  <script>
    import '@cvfile/viewer-web';

    const dz = document.getElementById('dropzone')!;
    const picker = document.getElementById('picker') as HTMLInputElement;
    const loadSample = document.getElementById('load-sample') as HTMLButtonElement;
    const viewer = document.getElementById('viewer') as HTMLElement & {
      loadFromBytes(bytes: Uint8Array): Promise<void>;
    };

    function show(): void {
      dz.style.display = 'none';
      viewer.style.display = 'block';
    }

    async function handle(file: File | Blob): Promise<void> {
      const buf = new Uint8Array(await file.arrayBuffer());
      show();
      await viewer.loadFromBytes(buf);
    }

    picker.addEventListener('change', () => {
      const file = picker.files?.[0];
      if (file) void handle(file);
    });
    dz.addEventListener('dragover', (e) => {
      e.preventDefault();
      dz.style.background = 'rgba(127,127,127,0.08)';
    });
    dz.addEventListener('dragleave', () => {
      dz.style.background = '';
    });
    dz.addEventListener('drop', (e) => {
      e.preventDefault();
      dz.style.background = '';
      const file = e.dataTransfer?.files?.[0];
      if (file) void handle(file);
    });

    loadSample.addEventListener('click', async () => {
      loadSample.disabled = true;
      loadSample.textContent = 'Loading sample…';
      try {
        const res = await fetch('/samples/jane-doe.cv');
        const blob = await res.blob();
        await handle(blob);
      } finally {
        loadSample.disabled = false;
        loadSample.textContent = 'Load sample .cv';
      }
    });
  </script>
</Page>
