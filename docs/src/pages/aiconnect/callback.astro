---
// The return page of the AI mode's web sign ins (OpenRouter, TensorPass): it hands the sign in to the page
// that opened it and closes. It renders nothing of the site and stays out of search engines and the sitemap.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Signing in · cvfile.org</title>
  </head>
  <body>
    <script>
      import { finishSignIn } from '@tensorpass/aiconnect/callback';

      finishSignIn();
    </script>
  </body>
</html>
