---
import Page from '../layouts/Page.astro';
import { graph, ORGANIZATION, WEBSITE, breadcrumbs } from '../lib/structured-data';

const jsonLd = graph([
  ORGANIZATION,
  WEBSITE,
  breadcrumbs([
    { name: 'cvfile.org', url: 'https://cvfile.org/' },
    { name: 'Create', url: 'https://cvfile.org/create/' },
  ]),
]);
---
<Page
  title="Create your .cv file in the browser — cvfile.org"
  description="Fill a short form and download a spec-conformant .cv file with a designed PDF, Markdown copy, and HTML rendering bundled. No account, no upload, runs entirely in your browser."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <h1>Create your .cv in the browser</h1>
  <p style="color: var(--muted)">
    Fill the form. Nothing leaves your browser. Click <strong>Download .cv</strong>
    to get a spec-conformant file you can upload to Workday, Greenhouse,
    Lever, LinkedIn, your site, or email to a recruiter.
  </p>

  <form id="cv-form" autocomplete="on">
    <fieldset class="cv-fieldset">
      <legend>Identity</legend>
      <label>Full name <input name="name" required placeholder="Jane Doe" /></label>
      <label>Headline <input name="headline" placeholder="Senior Software Engineer" /></label>
      <label>Email <input name="email" type="email" placeholder="jane@example.com" /></label>
      <label>Location <input name="location" placeholder="Lyon, France" /></label>
      <label>Website <input name="website" placeholder="https://janedoe.dev" /></label>
      <label>Primary language (BCP-47) <input name="lang" value="en" required /></label>
    </fieldset>

    <fieldset class="cv-fieldset">
      <legend>Summary</legend>
      <label><textarea name="summary" rows="3" placeholder="One paragraph about you and what you're looking for."></textarea></label>
    </fieldset>

    <fieldset class="cv-fieldset">
      <legend>Experience <button type="button" id="add-exp" class="add-btn">+ Add role</button></legend>
      <div id="experience-list"></div>
    </fieldset>

    <fieldset class="cv-fieldset">
      <legend>Education <button type="button" id="add-edu" class="add-btn">+ Add education</button></legend>
      <div id="education-list"></div>
    </fieldset>

    <fieldset class="cv-fieldset">
      <legend>Skills</legend>
      <label>Comma-separated <input name="skills" placeholder="Python, Kubernetes, Distributed systems, French (native), English (fluent)" /></label>
    </fieldset>

    <div class="cv-actions">
      <button type="button" id="download" class="primary-btn">Download .cv</button>
      <button type="button" id="preview" class="secondary-btn">Preview Markdown</button>
      <span id="status" style="color: var(--muted); font-size: 0.9rem;"></span>
    </div>
  </form>

  <details id="preview-wrap" style="margin-top: 1.5rem; display: none;">
    <summary style="cursor: pointer; font-weight: 600;">Generated Markdown</summary>
    <pre id="preview-md" style="margin-top: 0.75rem; white-space: pre-wrap;"></pre>
  </details>

  <style is:global>
    .cv-fieldset {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.25rem 1.25rem;
      margin: 1.25rem 0;
    }
    .cv-fieldset legend {
      padding: 0 0.5rem;
      font-weight: 600;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    .cv-fieldset label {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
      margin-top: 0.75rem;
      font-size: 0.92rem;
      color: var(--muted);
    }
    .cv-fieldset input,
    .cv-fieldset textarea {
      padding: 0.55rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: var(--bg);
      color: var(--fg);
      font: inherit;
      width: 100%;
    }
    .cv-fieldset input:focus,
    .cv-fieldset textarea:focus {
      outline: 2px solid var(--accent);
      outline-offset: 1px;
    }
    .add-btn {
      background: transparent;
      border: 1px solid var(--border);
      border-radius: 6px;
      padding: 0.25rem 0.6rem;
      font-size: 0.85rem;
      cursor: pointer;
      color: var(--fg);
    }
    .remove-btn {
      background: transparent;
      border: 0;
      color: var(--muted);
      cursor: pointer;
      font-size: 0.85rem;
      padding: 0.25rem 0.5rem;
    }
    .remove-btn:hover { color: #ef4444; }
    .entry {
      border: 1px dashed var(--border);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      margin-top: 1rem;
    }
    .entry-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 0.25rem;
    }
    .row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0.75rem;
    }
    @media (max-width: 600px) {
      .row { grid-template-columns: 1fr; }
    }
    .cv-actions {
      display: flex;
      gap: 0.75rem;
      align-items: center;
      flex-wrap: wrap;
      margin-top: 1.5rem;
    }
    .primary-btn {
      background: var(--accent);
      color: #fff;
      border: 0;
      padding: 0.65rem 1.3rem;
      border-radius: 8px;
      font-weight: 600;
      cursor: pointer;
      font: inherit;
    }
    .primary-btn:disabled { opacity: 0.6; cursor: not-allowed; }
    .secondary-btn {
      background: transparent;
      color: inherit;
      border: 1px solid var(--border);
      padding: 0.65rem 1.3rem;
      border-radius: 8px;
      cursor: pointer;
      font: inherit;
    }
  </style>

  <script>
    import { pack } from '@cvfile/sdk';
    import { PDFDocument, StandardFonts, rgb } from 'pdf-lib';

    interface Experience {
      role: string;
      company: string;
      dates: string;
      description: string;
    }
    interface Education {
      degree: string;
      school: string;
      dates: string;
    }

    const expList = document.getElementById('experience-list')!;
    const eduList = document.getElementById('education-list')!;

    function expEntry(): HTMLElement {
      const div = document.createElement('div');
      div.className = 'entry';
      div.innerHTML = `
        <div class="entry-header">
          <strong style="font-size: 0.92rem; color: var(--muted)">Role</strong>
          <button type="button" class="remove-btn">remove</button>
        </div>
        <div class="row">
          <label>Title <input data-field="role" placeholder="Senior Software Engineer" /></label>
          <label>Company <input data-field="company" placeholder="Acme Inc." /></label>
        </div>
        <label>Dates <input data-field="dates" placeholder="Jan 2023 — present" /></label>
        <label>What you did <textarea data-field="description" rows="3" placeholder="Two or three bullet-style lines."></textarea></label>
      `;
      div.querySelector('.remove-btn')!.addEventListener('click', () => div.remove());
      return div;
    }

    function eduEntry(): HTMLElement {
      const div = document.createElement('div');
      div.className = 'entry';
      div.innerHTML = `
        <div class="entry-header">
          <strong style="font-size: 0.92rem; color: var(--muted)">Education</strong>
          <button type="button" class="remove-btn">remove</button>
        </div>
        <div class="row">
          <label>Degree / programme <input data-field="degree" placeholder="MSc Computer Science" /></label>
          <label>School <input data-field="school" placeholder="ENS Lyon" /></label>
        </div>
        <label>Dates <input data-field="dates" placeholder="2018 — 2021" /></label>
      `;
      div.querySelector('.remove-btn')!.addEventListener('click', () => div.remove());
      return div;
    }

    document.getElementById('add-exp')!.addEventListener('click', () => expList.appendChild(expEntry()));
    document.getElementById('add-edu')!.addEventListener('click', () => eduList.appendChild(eduEntry()));

    expList.appendChild(expEntry());
    eduList.appendChild(eduEntry());

    function getString(name: string): string {
      const el = document.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[name="${name}"]`);
      return el ? el.value.trim() : '';
    }

    function collect(listEl: HTMLElement, fields: string[]): Array<Record<string, string>> {
      const out: Array<Record<string, string>> = [];
      for (const entry of Array.from(listEl.children)) {
        const obj: Record<string, string> = {};
        for (const f of fields) {
          const el = entry.querySelector<HTMLInputElement | HTMLTextAreaElement>(`[data-field="${f}"]`);
          obj[f] = el ? el.value.trim() : '';
        }
        if (Object.values(obj).some((v) => v)) out.push(obj);
      }
      return out;
    }

    function buildMarkdown(): { md: string; name: string; lang: string } {
      const name = getString('name') || 'Untitled';
      const headline = getString('headline');
      const email = getString('email');
      const location = getString('location');
      const website = getString('website');
      const lang = getString('lang') || 'en';
      const summary = getString('summary');
      const skills = getString('skills');
      const experience = collect(expList, ['role', 'company', 'dates', 'description']) as Experience[];
      const education = collect(eduList, ['degree', 'school', 'dates']) as Education[];

      const lines: string[] = [`# ${name}`];
      if (headline) lines.push('', `*${headline}*`);
      const contact = [email, location, website].filter(Boolean).join(' · ');
      if (contact) lines.push('', contact);
      if (summary) lines.push('', '## Summary', '', summary);
      if (experience.length) {
        lines.push('', '## Experience');
        for (const e of experience) {
          const heading = [e.role, e.company].filter(Boolean).join(' · ');
          if (heading) lines.push('', `### ${heading}`);
          if (e.dates) lines.push(`*${e.dates}*`);
          if (e.description) lines.push('', e.description);
        }
      }
      if (education.length) {
        lines.push('', '## Education');
        for (const e of education) {
          const heading = [e.degree, e.school].filter(Boolean).join(' · ');
          if (heading) lines.push('', `### ${heading}`);
          if (e.dates) lines.push(`*${e.dates}*`);
        }
      }
      if (skills) lines.push('', '## Skills', '', skills);
      return { md: lines.join('\n') + '\n', name, lang };
    }

    async function renderPDF(md: string): Promise<Uint8Array> {
      const doc = await PDFDocument.create();
      const font = await doc.embedFont(StandardFonts.Helvetica);
      const bold = await doc.embedFont(StandardFonts.HelveticaBold);
      const italic = await doc.embedFont(StandardFonts.HelveticaOblique);

      const margin = 56;
      const pageWidth = 595.28;
      const pageHeight = 841.89;
      const maxWidth = pageWidth - margin * 2;
      let page = doc.addPage([pageWidth, pageHeight]);
      let y = pageHeight - margin;

      const wrap = (text: string, size: number, f = font): string[] => {
        const words = text.split(/\s+/);
        const lines: string[] = [];
        let cur = '';
        for (const w of words) {
          const tryLine = cur ? `${cur} ${w}` : w;
          if (f.widthOfTextAtSize(tryLine, size) > maxWidth && cur) {
            lines.push(cur);
            cur = w;
          } else {
            cur = tryLine;
          }
        }
        if (cur) lines.push(cur);
        return lines;
      };

      const draw = (text: string, size: number, f = font, gap = 4): void => {
        for (const line of wrap(text, size, f)) {
          if (y - size < margin) {
            page = doc.addPage([pageWidth, pageHeight]);
            y = pageHeight - margin;
          }
          page.drawText(line, { x: margin, y: y - size, size, font: f, color: rgb(0.07, 0.07, 0.08) });
          y -= size + gap;
        }
      };

      const spacer = (h: number): void => { y -= h; };

      for (const raw of md.split('\n')) {
        const line = raw.trimEnd();
        if (!line) { spacer(6); continue; }
        if (line.startsWith('# ')) { draw(line.slice(2), 26, bold, 6); spacer(4); }
        else if (line.startsWith('## ')) { spacer(8); draw(line.slice(3), 16, bold, 4); spacer(2); }
        else if (line.startsWith('### ')) { spacer(4); draw(line.slice(4), 12, bold, 3); }
        else if (line.startsWith('*') && line.endsWith('*')) { draw(line.slice(1, -1), 11, italic, 3); }
        else { draw(line, 11, font, 3); }
      }

      return doc.save();
    }

    function downloadBytes(bytes: Uint8Array, filename: string): void {
      const blob = new Blob([bytes], { type: 'application/vnd.cv+pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function slug(name: string): string {
      return name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '') || 'resume';
    }

    const status = document.getElementById('status')!;
    const previewBtn = document.getElementById('preview') as HTMLButtonElement;
    const previewWrap = document.getElementById('preview-wrap') as HTMLDetailsElement;
    const previewMd = document.getElementById('preview-md')!;
    const downloadBtn = document.getElementById('download') as HTMLButtonElement;

    previewBtn.addEventListener('click', () => {
      const { md } = buildMarkdown();
      previewMd.textContent = md;
      previewWrap.open = true;
      previewWrap.style.display = 'block';
    });

    downloadBtn.addEventListener('click', async () => {
      if (!getString('name')) {
        status.textContent = 'Add at least a name first.';
        return;
      }
      downloadBtn.disabled = true;
      status.textContent = 'Building PDF…';
      try {
        const { md, name, lang } = buildMarkdown();
        const pdfBytes = await renderPDF(md);
        status.textContent = 'Packing .cv…';
        const cvBytes = await pack({
          pdf: pdfBytes,
          markdown: md,
          metadata: {
            primaryLanguage: lang,
            primaryPayload: 'resume.md',
            generator: 'cvfile.org/create',
            integrity: 'sha-256',
          },
        });
        downloadBytes(cvBytes, `${slug(name)}.cv`);
        status.textContent = 'Downloaded.';
      } catch (e) {
        status.textContent = `Failed: ${(e as Error).message}`;
      } finally {
        downloadBtn.disabled = false;
      }
    });
  </script>
</Page>
