---
import Page from '../layouts/Page.astro';
import { graph, ORGANIZATION, WEBSITE, breadcrumbs } from '../lib/structured-data';

const jsonLd = graph([
  ORGANIZATION,
  WEBSITE,
  breadcrumbs([
    { name: 'cvfile.org', url: 'https://cvfile.org/' },
    { name: 'Create', url: 'https://cvfile.org/create/' },
  ]),
]);
---
<Page
  title="Create your .cv file in the browser — cvfile.org"
  description="Drop your existing PDF resume and Markdown copy. Get a spec-conformant .cv with PDF + Markdown + HTML + optional BGE-M3 embeddings. Runs entirely in your browser. No upload, no account."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <h1>Make your .cv</h1>
  <p style="color: var(--muted); max-width: 65ch">
    Drop your <strong>PDF resume</strong> and your resume in <strong>Markdown</strong>.
    We pack them into one <code>.cv</code> file along with a clean HTML
    rendering and, if you want, semantic embeddings for AI search. Nothing
    leaves your browser. No account, no upload.
  </p>

  <details style="margin: 1.25rem 0; padding: 0.85rem 1.1rem; border: 1px solid var(--border); border-radius: 8px;">
    <summary style="cursor: pointer; font-weight: 600;">Don't have a Markdown copy yet? Ask ChatGPT or Claude.</summary>
    <p style="margin-top: 0.75rem;">
      Upload your PDF to ChatGPT or Claude, then paste this prompt:
    </p>
    <pre style="white-space: pre-wrap; font-size: 0.85rem;"><code>Convert this resume to clean Markdown that an ATS or LLM can parse perfectly. Keep every section, every role, every date, every bullet. Use # for the name, ## for section headers (Summary, Experience, Education, Skills, etc.), ### for individual roles or schools. Italicise dates with *. No tables. No emojis. No commentary. Output only the Markdown, nothing else.</code></pre>
    <p style="color: var(--muted); font-size: 0.92rem;">
      Save the output as <code>resume.md</code> or paste it into the box
      below.
    </p>
  </details>

  <section class="cv-fieldset">
    <h2 style="margin: 0 0 0.5rem;">1 · PDF</h2>
    <div id="pdf-drop" class="dropzone">
      <strong id="pdf-label">Drop your PDF here</strong>
      <div style="color: var(--muted); margin-top: 0.4rem;">or click to choose</div>
      <input id="pdf-picker" type="file" accept="application/pdf,.pdf" hidden />
    </div>
  </section>

  <section class="cv-fieldset">
    <h2 style="margin: 0 0 0.5rem;">2 · Markdown</h2>
    <div class="tabs">
      <button type="button" class="tab active" data-tab="paste">Paste</button>
      <button type="button" class="tab" data-tab="drop">Drop a .md file</button>
    </div>
    <div id="md-paste" class="tab-panel">
      <textarea id="md-text" rows="10" placeholder="# Jane Doe&#10;&#10;## Experience&#10;&#10;### Senior Engineer · Acme Inc.&#10;*Jan 2023 — present*&#10;&#10;Led the platform team..."></textarea>
    </div>
    <div id="md-drop-panel" class="tab-panel" hidden>
      <div id="md-drop" class="dropzone">
        <strong id="md-label">Drop your .md here</strong>
        <div style="color: var(--muted); margin-top: 0.4rem;">or click to choose</div>
        <input id="md-picker" type="file" accept=".md,text/markdown,text/plain" hidden />
      </div>
    </div>
  </section>

  <section class="cv-fieldset">
    <h2 style="margin: 0 0 0.5rem;">3 · Metadata</h2>
    <div class="row">
      <label>Primary language (BCP-47)
        <input id="lang" value="en" />
      </label>
      <label>Output filename
        <input id="filename" value="resume.cv" />
      </label>
    </div>
  </section>

  <section class="cv-fieldset">
    <h2 style="margin: 0 0 0.5rem;">4 · Embeddings <span style="font-size: 0.85rem; font-weight: 400; color: var(--muted)">optional</span></h2>
    <p style="color: var(--muted); margin: 0 0 0.75rem;">
      Add pre-computed semantic vectors so AI tools that recognise
      <code>.cv</code> can search your resume without re-embedding. The model
      downloads once into your browser cache (about 30 MB) and then runs
      locally on your machine. Your resume <strong>never leaves the
      browser</strong>.
    </p>
    <label class="cv-checkbox">
      <input id="emb-toggle" type="checkbox" />
      Add embeddings (downloads ~30 MB AI model once, fully local)
    </label>
  </section>

  <div class="cv-actions">
    <button type="button" id="build" class="primary-btn">Build .cv</button>
    <span id="status" style="color: var(--muted); font-size: 0.92rem;"></span>
  </div>

  <style is:global>
    .cv-fieldset {
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 1rem 1.25rem 1.25rem;
      margin: 1.25rem 0;
    }
    .cv-fieldset h2 { font-size: 1.05rem; font-weight: 600; }
    .cv-fieldset label {
      display: flex; flex-direction: column; gap: 0.25rem;
      margin-top: 0.5rem; font-size: 0.92rem; color: var(--muted);
    }
    .cv-fieldset label.cv-checkbox {
      flex-direction: row; align-items: center; gap: 0.5rem;
      color: var(--fg); font-size: 0.95rem;
    }
    .cv-fieldset input,
    .cv-fieldset textarea {
      padding: 0.55rem 0.75rem; border: 1px solid var(--border); border-radius: 6px;
      background: var(--bg); color: var(--fg); font: inherit; width: 100%;
    }
    .cv-fieldset textarea { font-family: ui-monospace, "SF Mono", Menlo, monospace; font-size: 0.88rem; }
    .cv-fieldset input:focus, .cv-fieldset textarea:focus { outline: 2px solid var(--accent); outline-offset: 1px; }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
    @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }
    .dropzone {
      border: 2px dashed var(--border); border-radius: 10px; padding: 1.75rem;
      text-align: center; cursor: pointer; transition: background 120ms;
    }
    .dropzone.over { background: rgba(127,127,127,0.08); }
    .dropzone.loaded { border-style: solid; border-color: var(--accent); }
    .tabs { display: flex; gap: 0.25rem; margin-bottom: 0.75rem; border-bottom: 1px solid var(--border); }
    .tab {
      background: transparent; border: 0; border-bottom: 2px solid transparent;
      padding: 0.55rem 0.85rem; cursor: pointer; color: var(--muted);
      font: inherit; font-size: 0.92rem;
    }
    .tab.active { color: var(--fg); border-bottom-color: var(--accent); }
    .tab-panel[hidden] { display: none; }
    .cv-actions { display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap; margin-top: 1.5rem; }
    .primary-btn {
      background: var(--accent); color: #fff; border: 0;
      padding: 0.7rem 1.4rem; border-radius: 8px; font-weight: 600;
      cursor: pointer; font: inherit;
    }
    .primary-btn:disabled { opacity: 0.6; cursor: not-allowed; }
  </style>

  <script>
    import { pack } from '@cvfile/sdk';
    import { marked } from 'marked';

    const pdfDrop = document.getElementById('pdf-drop')!;
    const pdfPicker = document.getElementById('pdf-picker') as HTMLInputElement;
    const pdfLabel = document.getElementById('pdf-label')!;
    let pdfBytes: Uint8Array | null = null;

    const mdDrop = document.getElementById('md-drop')!;
    const mdPicker = document.getElementById('md-picker') as HTMLInputElement;
    const mdLabel = document.getElementById('md-label')!;
    const mdText = document.getElementById('md-text') as HTMLTextAreaElement;

    const langInput = document.getElementById('lang') as HTMLInputElement;
    const filenameInput = document.getElementById('filename') as HTMLInputElement;
    const embToggle = document.getElementById('emb-toggle') as HTMLInputElement;

    const status = document.getElementById('status')!;
    const buildBtn = document.getElementById('build') as HTMLButtonElement;

    function bindDrop(zone: HTMLElement, picker: HTMLInputElement, onFile: (f: File) => void): void {
      zone.addEventListener('click', () => picker.click());
      picker.addEventListener('change', () => { const f = picker.files?.[0]; if (f) onFile(f); });
      zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('over'); });
      zone.addEventListener('dragleave', () => zone.classList.remove('over'));
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('over');
        const f = e.dataTransfer?.files?.[0];
        if (f) onFile(f);
      });
    }

    bindDrop(pdfDrop, pdfPicker, async (file) => {
      pdfBytes = new Uint8Array(await file.arrayBuffer());
      pdfLabel.textContent = `${file.name} (${(pdfBytes.length / 1024).toFixed(1)} KB)`;
      pdfDrop.classList.add('loaded');
    });

    bindDrop(mdDrop, mdPicker, async (file) => {
      const text = await file.text();
      mdText.value = text;
      mdLabel.textContent = `${file.name} (${text.length} chars)`;
      mdDrop.classList.add('loaded');
    });

    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const which = tab.dataset.tab;
        (document.getElementById('md-paste') as HTMLElement).hidden = which !== 'paste';
        (document.getElementById('md-drop-panel') as HTMLElement).hidden = which !== 'drop';
      });
    });

    function renderHtml(md: string, title: string, lang: string): string {
      const body = marked.parse(md, { async: false }) as string;
      const safeTitle = title.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      );
      return `<!doctype html>
<html lang="${lang}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${safeTitle}</title>
<style>
:root { color-scheme: light dark; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.65; }
body { max-width: 720px; margin: 2.5rem auto; padding: 0 1.5rem; color: #111; background: #fff; }
@media (prefers-color-scheme: dark) { body { color: #f3f4f6; background: #0b0b0d; } }
h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }
h2 { margin-top: 2rem; padding-bottom: 0.25rem; border-bottom: 1px solid currentColor; }
h3 { margin-top: 1.25rem; }
em { color: inherit; opacity: 0.75; }
ul { padding-left: 1.25rem; }
</style>
</head>
<body>
${body}
</body>
</html>
`;
    }

    function firstHeading(md: string): string {
      const m = md.match(/^#\s+(.+)$/m);
      return m ? m[1]!.trim() : 'Resume';
    }

    function downloadBytes(bytes: Uint8Array, filename: string): void {
      const blob = new Blob([bytes], { type: 'application/vnd.cv+pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function setStatus(msg: string): void { status.textContent = msg; }

    buildBtn.addEventListener('click', async () => {
      if (!pdfBytes) { setStatus('Drop a PDF first.'); return; }
      const md = mdText.value.trim();
      if (!md) { setStatus('Paste or drop your Markdown first.'); return; }

      buildBtn.disabled = true;
      try {
        const lang = (langInput.value.trim() || 'en');
        const title = firstHeading(md);
        const html = renderHtml(md, title, lang);

        let embeddings;
        if (embToggle.checked) {
          setStatus('Loading embedding model (one-time ~30 MB download)…');
          const { embed, createTransformersBackend } = await import('@cvfile/embed');
          // all-MiniLM-L6-v2: 384-dim, ~7 MB quantised, English-dominant but
          // works well enough for resume semantic search. The spec records
          // the model id so consumers can match it at query time.
          const backend = createTransformersBackend({
            model: 'Xenova/all-MiniLM-L6-v2',
            modelRevision: 'main',
            dimension: 384,
            metric: 'cosine',
            dtype: 'q8',
          });
          setStatus('Embedding your resume locally…');
          embeddings = await embed(md, { backend, chunking: 'section' });
        }

        setStatus('Packing .cv…');
        const cvBytes = await pack({
          pdf: pdfBytes,
          markdown: md,
          html,
          ...(embeddings ? { embeddings } : {}),
          metadata: {
            primaryLanguage: lang,
            primaryPayload: 'resume.md',
            generator: 'cvfile.org/create',
            integrity: 'sha-256',
          },
        });

        const name = (filenameInput.value.trim() || 'resume.cv').replace(/[^a-zA-Z0-9._-]/g, '_');
        downloadBytes(cvBytes, name.endsWith('.cv') ? name : `${name}.cv`);
        const parts = ['PDF', 'Markdown', 'HTML'];
        if (embeddings) parts.push(`${embeddings.spaces[0]!.chunks.length} BGE-M3 vectors`);
        setStatus(`Done — packed ${parts.join(' + ')} into ${(cvBytes.length / 1024).toFixed(1)} KB.`);
      } catch (e) {
        setStatus(`Failed: ${(e as Error).message}`);
      } finally {
        buildBtn.disabled = false;
      }
    });
  </script>
</Page>
