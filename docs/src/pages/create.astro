---
import Page from '../layouts/Page.astro';
import { graph, ORGANIZATION, WEBSITE, breadcrumbs } from '../lib/structured-data';

const jsonLd = graph([
  ORGANIZATION,
  WEBSITE,
  breadcrumbs([
    { name: 'cvfile.org', url: 'https://cvfile.org/' },
    { name: 'Create', url: 'https://cvfile.org/create/' },
  ]),
]);
---
<Page
  title="Create your .cv file in the browser · cvfile.org"
  description="Drop your existing PDF resume and Markdown copy. Get a spec-conformant .cv with PDF + Markdown + HTML + optional BGE-M3 embeddings. Runs entirely in your browser. No upload, no account."
>
  <script type="application/ld+json" slot="head" set:html={jsonLd} />

  <div class="doc doc--narrow builder">
    <header class="page-head">
      <span class="kicker label">§01 / Create</span>
      <h1>Make your <code>.cv</code> in the browser.</h1>
      <p>
        Drop your <strong>PDF resume</strong> and a <strong>Markdown</strong>
        copy. We pack them into one <code>.cv</code> file with a clean HTML
        rendering and, if you want, semantic embeddings. Nothing leaves your
        browser. No account, no upload.
      </p>
    </header>

    <details class="hint">
      <summary>No Markdown copy yet? Ask ChatGPT or Claude.</summary>
      <div class="hint__body">
        <p>Upload your PDF to ChatGPT or Claude, then paste this prompt:</p>
        <p class="plate-caption">prompt</p>
        <pre><code>Convert this resume to clean Markdown that an ATS or LLM can parse perfectly. Keep every section, every role, every date, every bullet. Use # for the name, ## for section headers (Summary, Experience, Education, Skills, etc.), ### for individual roles or schools. Italicise dates with *. No tables. No emojis. No commentary. Output only the Markdown, nothing else.</code></pre>
        <p>Save the output as <code>resume.md</code> or paste it into the box below.</p>
      </div>
    </details>

    <section class="step">
      <div class="step__num">01</div>
      <div class="step__body">
        <h2 class="step__title">PDF</h2>
        <label id="pdf-drop" class="dropzone">
          <strong id="pdf-label">Drop your PDF here</strong>
          <span class="dropzone__sub">or click to choose</span>
          <input id="pdf-picker" class="visually-hidden-file" type="file" accept="application/pdf,.pdf" />
        </label>
      </div>
    </section>

    <section class="step">
      <div class="step__num">02</div>
      <div class="step__body">
        <h2 class="step__title">Markdown</h2>
        <div class="tabs">
          <button type="button" class="tab active" data-tab="paste">Paste</button>
          <button type="button" class="tab" data-tab="drop">Drop a .md file</button>
        </div>
        <div id="md-paste" class="tab-panel">
          <textarea id="md-text" rows="10" placeholder="# Jane Doe&#10;&#10;## Experience&#10;&#10;### Senior Engineer · Acme Inc.&#10;*Jan 2023 to present*&#10;&#10;Led the platform team..."></textarea>
        </div>
        <div id="md-drop-panel" class="tab-panel" hidden>
          <label id="md-drop" class="dropzone">
            <strong id="md-label">Drop your .md here</strong>
            <span class="dropzone__sub">or click to choose</span>
            <input id="md-picker" class="visually-hidden-file" type="file" accept=".md,text/markdown,text/plain" />
          </label>
        </div>
      </div>
    </section>

    <section class="step">
      <div class="step__num">03</div>
      <div class="step__body">
        <h2 class="step__title">Metadata</h2>
        <div class="row">
          <label>Primary language (BCP-47)
            <input id="lang" value="en" />
          </label>
          <label>Output filename
            <input id="filename" value="resume.cv" />
          </label>
        </div>
      </div>
    </section>

    <div class="cv-actions">
      <button type="button" id="build" class="btn btn--primary">Build .cv <span class="arrow">→</span></button>
      <span id="status" class="cv-status"></span>
    </div>

    <p class="note">
      Want BGE-M3 semantic embeddings? Generate them with the Python package
      (<a href="/install/"><code>pip install "cvfile[embed]"</code></a>): run
      <code>embed(markdown)</code>, then pack with
      <code>pack(..., embeddings=encode_embeddings(payload))</code>. The model is
      ~285 MB, so it runs once locally on your machine, not on every visitor's
      browser. The <code>cv</code> CLI is reader-only (extract, inspect,
      validate, search) and does not generate embeddings.
    </p>
  </div>

  <style is:global>
    .builder .hint { margin: 0 0 var(--space-2xl); border: 1px solid var(--line); border-radius: var(--radius); overflow: hidden; }
    .builder .hint summary {
      display: flex; align-items: center; gap: var(--space-sm);
      padding: var(--space-md); cursor: pointer; list-style: none;
      font-weight: 600; color: var(--ink); font-family: var(--display);
    }
    .builder .hint summary::-webkit-details-marker { display: none; }
    .builder .hint[open] summary { border-bottom: 1px solid var(--line); }
    .builder .hint__body { padding: var(--space-md); }
    .builder .hint__body > :first-child { margin-top: 0; }

    .step {
      display: grid;
      grid-template-columns: 3.5rem 1fr;
      gap: var(--space-lg);
      padding: var(--space-xl) 0;
      border-top: 1px solid var(--line);
      align-items: start;
    }
    .step__num { font-family: var(--display); font-weight: 800; font-size: 1.5rem; color: var(--ink-faint); line-height: 1; padding-top: 0.15rem; }
    .step__title { font-family: var(--mono); font-size: 0.78rem; letter-spacing: 0.16em; text-transform: uppercase; color: var(--ink-soft); font-weight: 500; margin: 0 0 var(--space-md); border: 0; padding: 0; }
    .step__body { min-width: 0; }
    @media (max-width: 600px) {
      .step { grid-template-columns: 1fr; gap: var(--space-xs); padding: var(--space-lg) 0; }
      .step__num { font-size: 1.1rem; padding-top: 0; }
    }

    .step label { display: flex; flex-direction: column; gap: var(--space-2xs); font-family: var(--mono); font-size: 0.72rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--ink-faint); }
    .step input, .step textarea {
      padding: 0.6rem 0.8rem; border: 1px solid var(--line); border-radius: var(--radius);
      background: var(--paper); color: var(--ink); font-family: var(--mono); font-size: 0.9rem; width: 100%;
    }
    .step textarea { line-height: 1.6; resize: vertical; }
    .step input:focus, .step textarea:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in oklab, var(--accent) 22%, transparent); }
    .row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-md); }
    @media (max-width: 600px) { .row { grid-template-columns: 1fr; } }

    .dropzone {
      position: relative;
      display: flex; flex-direction: column; align-items: center; gap: var(--space-2xs);
      border: 1.5px dashed var(--line-strong); border-radius: var(--radius);
      padding: var(--space-2xl) var(--space-lg); text-align: center; cursor: pointer;
      background: color-mix(in oklab, var(--paper-2) 50%, transparent);
      transition: background 140ms, border-color 140ms;
    }
    .dropzone strong { color: var(--ink); font-family: var(--mono); font-size: 0.9rem; }
    .dropzone__sub { color: var(--ink-faint); font-family: var(--mono); font-size: 0.74rem; }
    .dropzone:hover { border-color: var(--ink-faint); }
    .dropzone.over { background: color-mix(in oklab, var(--accent) 8%, var(--paper)); border-color: var(--accent); }
    .dropzone.loaded { border-style: solid; border-color: var(--accent); background: color-mix(in oklab, var(--accent) 6%, var(--paper)); }

    .tabs { display: flex; gap: var(--space-md); margin-bottom: var(--space-md); border-bottom: 1px solid var(--line); }
    .tab {
      background: transparent; border: 0; border-bottom: 2px solid transparent;
      padding: var(--space-xs) 0; cursor: pointer; color: var(--ink-faint);
      font-family: var(--mono); font-size: 0.76rem; letter-spacing: 0.04em; text-transform: uppercase;
      transition: color 140ms;
    }
    .tab:hover { color: var(--ink-soft); }
    .tab.active { color: var(--ink); border-bottom-color: var(--accent); }
    .tab-panel[hidden] { display: none; }

    .cv-actions { display: flex; gap: var(--space-md); align-items: center; flex-wrap: wrap; margin-top: var(--space-xl); padding-top: var(--space-xl); border-top: 1px solid var(--line); }
    .btn--primary:disabled { opacity: 0.55; cursor: not-allowed; }
    .cv-status { font-family: var(--mono); font-size: 0.8rem; color: var(--ink-soft); }
    .builder .note { font-size: 0.9rem; color: var(--ink-soft); margin-top: var(--space-2xl); padding-top: var(--space-lg); border-top: 1px solid var(--line); }
  </style>

  <script>
    import { pack } from '@cvfile/sdk';

    const pdfDrop = document.getElementById('pdf-drop')!;
    const pdfPicker = document.getElementById('pdf-picker') as HTMLInputElement;
    const pdfLabel = document.getElementById('pdf-label')!;
    let pdfBytes: Uint8Array | null = null;

    const mdDrop = document.getElementById('md-drop')!;
    const mdPicker = document.getElementById('md-picker') as HTMLInputElement;
    const mdLabel = document.getElementById('md-label')!;
    const mdText = document.getElementById('md-text') as HTMLTextAreaElement;

    const langInput = document.getElementById('lang') as HTMLInputElement;
    const filenameInput = document.getElementById('filename') as HTMLInputElement;
    const status = document.getElementById('status')!;
    const buildBtn = document.getElementById('build') as HTMLButtonElement;

    function bindDrop(zone: HTMLElement, picker: HTMLInputElement, onFile: (f: File) => void): void {
      picker.addEventListener('change', () => { const f = picker.files?.[0]; if (f) onFile(f); });
      zone.addEventListener('dragover', (e) => { e.preventDefault(); zone.classList.add('over'); });
      zone.addEventListener('dragleave', () => zone.classList.remove('over'));
      zone.addEventListener('drop', (e) => {
        e.preventDefault();
        zone.classList.remove('over');
        const f = e.dataTransfer?.files?.[0];
        if (f) onFile(f);
      });
    }

    bindDrop(pdfDrop, pdfPicker, async (file) => {
      pdfBytes = new Uint8Array(await file.arrayBuffer());
      pdfLabel.textContent = `${file.name} (${(pdfBytes.length / 1024).toFixed(1)} KB)`;
      pdfDrop.classList.add('loaded');
    });

    bindDrop(mdDrop, mdPicker, async (file) => {
      const text = await file.text();
      mdText.value = text;
      mdLabel.textContent = `${file.name} (${text.length} chars)`;
      mdDrop.classList.add('loaded');
    });

    document.querySelectorAll<HTMLButtonElement>('.tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.tab').forEach((t) => t.classList.remove('active'));
        tab.classList.add('active');
        const which = tab.dataset.tab;
        (document.getElementById('md-paste') as HTMLElement).hidden = which !== 'paste';
        (document.getElementById('md-drop-panel') as HTMLElement).hidden = which !== 'drop';
      });
    });

    function escapeHtml(s: string): string {
      return s.replace(/[&<>"']/g, (c) =>
        ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]!
      );
    }

    async function renderHtml(md: string, title: string, lang: string): Promise<string> {
      // Lazy-load marked so its ~500KB bundle stays out of the initial chunk.
      const { marked } = await import('marked');
      // Spec §7.3: never bake raw, unsanitised HTML into resume.html. Escape
      // any inline/block HTML the author put in the Markdown instead of
      // passing it through verbatim.
      marked.use({
        renderer: {
          html(token: string | { text: string }): string {
            return escapeHtml(typeof token === 'string' ? token : token.text);
          },
        },
      });
      const body = marked.parse(md, { async: false }) as string;
      const safeTitle = escapeHtml(title);
      return `<!doctype html>
<html lang="${lang}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>${safeTitle}</title>
<style>
:root { color-scheme: light dark; font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", sans-serif; line-height: 1.65; }
body { max-width: 720px; margin: 2.5rem auto; padding: 0 1.5rem; color: #111; background: #fff; }
@media (prefers-color-scheme: dark) { body { color: #f3f4f6; background: #0b0b0d; } }
h1 { font-size: 2.2rem; margin: 0 0 0.5rem; }
h2 { margin-top: 2rem; padding-bottom: 0.25rem; border-bottom: 1px solid currentColor; }
h3 { margin-top: 1.25rem; }
em { color: inherit; opacity: 0.75; }
ul { padding-left: 1.25rem; }
</style>
</head>
<body>
${body}
</body>
</html>
`;
    }

    function firstHeading(md: string): string {
      const m = md.match(/^#\s+(.+)$/m);
      return m ? m[1]!.trim() : 'Resume';
    }

    function downloadBytes(bytes: Uint8Array, filename: string): void {
      const blob = new Blob([bytes], { type: 'application/vnd.cv+pdf' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      a.remove();
      setTimeout(() => URL.revokeObjectURL(url), 1000);
    }

    function setStatus(msg: string): void { status.textContent = msg; }

    buildBtn.addEventListener('click', async () => {
      if (!pdfBytes) { setStatus('Drop a PDF first.'); return; }
      const md = mdText.value.trim();
      if (!md) { setStatus('Paste or drop your Markdown first.'); return; }

      buildBtn.disabled = true;
      try {
        const lang = (langInput.value.trim() || 'en');
        const title = firstHeading(md);
        const html = await renderHtml(md, title, lang);

        setStatus('Packing .cv…');
        const cvBytes = await pack({
          pdf: pdfBytes,
          markdown: md,
          html,
          metadata: {
            primaryLanguage: lang,
            primaryPayload: 'resume.md',
            generator: 'cvfile.org/create',
            integrity: 'sha-256',
          },
        });

        const name = (filenameInput.value.trim() || 'resume.cv').replace(/[^a-zA-Z0-9._-]/g, '_');
        downloadBytes(cvBytes, name.endsWith('.cv') ? name : `${name}.cv`);
        setStatus(`Done. Packed PDF + Markdown + HTML into ${(cvBytes.length / 1024).toFixed(1)} KB.`);
      } catch (e) {
        setStatus(`Failed: ${(e as Error).message}`);
      } finally {
        buildBtn.disabled = false;
      }
    });
  </script>
</Page>
