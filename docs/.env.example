# The site. PUBLIC_TENSORPASS_SITE_KEY defaults to cvfile.org's public TensorPass site key (astro.config.mjs);
# a build for another domain sets its own key here.
# PUBLIC_TENSORPASS_SITE_KEY=tpk_...

# The API (server/main.ts), as `pnpm dev:server` and docs/vps/compose.yaml run it.
PORT=6736
SITE_DATA_DIR=server/dist
SITE_ORIGINS=http://localhost:6737
