# The site: the public TensorPass site key of the domain the pages are built for (astro.config.mjs). cvfile.org's
# key works on cvfile.org and localhost; the build fails without one.
PUBLIC_TENSORPASS_SITE_KEY=

# The API (server/main.ts), as `pnpm dev:server` and docs/vps/compose.yaml run it.
PORT=6736
SITE_DATA_DIR=server/dist
SITE_ORIGINS=http://localhost:6737
