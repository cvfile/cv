# cvfile.org. Published by root with vps-automation's publish-site.sh into
# /etc/caddy/conf.d/cvfile.caddy, imported from /etc/caddy/Caddyfile. The apex
# is the canonical host, www redirects to it.
#
# Cloudflare proxies both hosts. Caddy sets X-Real-IP itself: from
# CF-Connecting-IP when the request comes from a Cloudflare address
# (https://www.cloudflare.com/ips), from the connection otherwise. A value sent
# by the client never reaches the site.
(cvfile_cloudflare_addresses) {
	@cloudflare remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
}

cvfile.org {
	import security_headers
	import cvfile_cloudflare_addresses
	encode zstd gzip
	handle @cloudflare {
		reverse_proxy 127.0.0.1:9524 {
			header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:9524 {
			header_up X-Real-IP {remote_host}
		}
	}
}

www.cvfile.org {
	redir https://cvfile.org{uri} permanent
}
