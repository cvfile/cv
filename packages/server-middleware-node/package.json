{
  "name": "@cvfile/server",
  "version": "0.3.1",
  "description": "Server middleware that serves .cv files with HTTP Link header content negotiation. Express, Fastify, Hono adapters.",
  "license": "Apache-2.0",
  "homepage": "https://cvfile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cvfile/cv.git",
    "directory": "packages/server-middleware-node"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./express": {
      "import": {
        "types": "./dist/express.d.ts",
        "default": "./dist/express.js"
      },
      "require": {
        "types": "./dist/express.d.cts",
        "default": "./dist/express.cjs"
      }
    },
    "./fastify": {
      "import": {
        "types": "./dist/fastify.d.ts",
        "default": "./dist/fastify.js"
      },
      "require": {
        "types": "./dist/fastify.d.cts",
        "default": "./dist/fastify.cjs"
      }
    },
    "./hono": {
      "import": {
        "types": "./dist/hono.d.ts",
        "default": "./dist/hono.js"
      },
      "require": {
        "types": "./dist/hono.d.cts",
        "default": "./dist/hono.cjs"
      }
    }
  },
  "typesVersions": {
    "*": {
      "express": [
        "./dist/express.d.cts"
      ],
      "fastify": [
        "./dist/fastify.d.cts"
      ],
      "hono": [
        "./dist/hono.d.cts"
      ]
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@cvfile/sdk": "workspace:^"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "express": "^5.0.0",
    "fastify": "^5.9.0",
    "hono": "^4.12.27",
    "pdf-lib": "^1.17.1",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vitest": "^2.1.0"
  },
  "peerDependencies": {
    "express": "^4 || ^5",
    "fastify": "^4 || ^5",
    "hono": "^4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  }
}
