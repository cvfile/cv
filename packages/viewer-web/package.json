{
  "name": "@cvfile/viewer-web",
  "version": "0.1.0",
  "description": "<cv-embed> web component and standalone viewer for the .cv open file format.",
  "license": "Apache-2.0",
  "homepage": "https://cvfile.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/cvfile/cv",
    "directory": "packages/viewer-web"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cvfile/sdk": "workspace:*",
    "lit": "^3.2.0",
    "marked": "^14.1.0",
    "dompurify": "^3.2.0",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0"
  }
}
