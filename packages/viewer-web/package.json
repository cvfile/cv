{
  "name": "@cvfile/viewer-web",
  "version": "0.3.1",
  "description": "<cv-embed> web component and standalone viewer for the .cv open file format.",
  "license": "Apache-2.0",
  "homepage": "https://cvfile.org",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cvfile/cv.git",
    "directory": "packages/viewer-web"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./render-pdf": {
      "types": "./dist/render-pdf.d.ts",
      "import": "./dist/render-pdf.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./src/index.ts"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.cdn.config.ts",
    "dev": "vite",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@cvfile/sdk": "workspace:^",
    "dompurify": "^3.4.11",
    "lit": "^3.3.3",
    "marked": "^14.1.0",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "happy-dom": "^15",
    "tsup": "^8.3.0",
    "typescript": "^7.0.2",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
