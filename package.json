{
  "name": "cvfile-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "The .cv open file format — spec, SDKs, viewer, CLI",
  "license": "Apache-2.0",
  "homepage": "https://cvfile.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/cvfile/cv"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@11.0.8",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:interop": "pnpm --filter @cvfile/sdk exec vitest run tests/valid-vectors.test.ts tests/security.test.ts",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^9.17.0",
    "prettier": "^3.9.4",
    "turbo": "^2.10.2",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
