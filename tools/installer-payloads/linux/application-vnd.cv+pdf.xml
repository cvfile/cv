<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.cv+pdf">
    <comment>cvfile .cv document</comment>
    <comment xml:lang="fr">Document cvfile .cv</comment>
    <sub-class-of type="application/pdf"/>
    <generic-icon name="x-office-document"/>
    <glob pattern="*.cv"/>
    <!-- Falls back to PDF magic bytes when the file is served without
         a .cv extension. Combined with the cv:version XMP marker the
         producer side guarantees identification. -->
    <magic priority="60">
      <match value="%PDF-1." type="string" offset="0"/>
      <match value="%PDF-2." type="string" offset="0"/>
    </magic>
  </mime-type>
</mime-info>
